#!/bin/bash
JOBS_LIST=$(java -jar /var/lib/jenkins/jenkins-cli.jar -auth '{{ jenkins_user }}:{{ jenkins_api_token }}' -s http://{{ HOST }}:8080/ list-jobs)
if [ ! -z "${JOBS_LIST}" ]; then
    java -jar /var/lib/jenkins/jenkins-cli.jar -auth '{{ jenkins_user }}:{{ jenkins_api_token }}' -s http://{{ HOST }}:8080/ stop-builds ${JOBS_LIST}
fi
